# Environment configuration for Crawler Gemini Secure Proxy
# Do NOT commit your actual .env file with real secrets!

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=3000

# Primary and Fallback Models
PRIMARY_MODEL=gemini-2.5-flash
FALLBACK_MODEL=gemini-1.5-flash

# Maximum Retries for transient 503/429 errors
MAX_RETRIES=4
